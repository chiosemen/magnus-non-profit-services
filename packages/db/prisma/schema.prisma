generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ComplianceDeadlineType {
  FORM_990
  STATE_REGISTRATION
  GRANT_REPORT
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  FILED
}

enum WorkerRelationshipType {
  W2_EMPLOYEE
  CONTRACTOR_1099
  BOARD_MEMBER
}

enum WorkerTier {
  FREE
  PREMIUM
}

enum IncomeType {
  SALARY
  CONSULTING
  SPEAKING
  ROYALTY
}

enum TaxFormType {
  W2
  NEC_1099
  MISC_1099
}

enum AgentScopeType {
  ORG
  WORKER
  GRANT
}

enum AgentRunStatus {
  STARTED
  SUCCESS
  FAILED
}

enum AlertSeverity {
  LOW
  MED
  HIGH
  CRITICAL
}

enum PromptType {
  GRANT_DRAFT
  BOARD_REPORT
  DONOR_UPDATE
  INTERNAL_MEMO
}

enum ClaudeStatus {
  NOT_ENABLED
  CONFIGURING
  ACTIVE
  SUSPENDED
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
  partnerUsers PartnerUser[]
}

model Organization {
  id              String           @id @default(uuid()) @db.Uuid
  ein             String           @unique
  name            String
  annualRevenue   Decimal?         @db.Decimal(12, 2)
  fiscalYearEnd   DateTime?
  subscriptionTier SubscriptionTier
  claudeStatus    ClaudeStatus     @default(NOT_ENABLED)
  plaidAccessToken String?         // encrypted
  /// Structured Form 990 readiness filing (snake_case API shape + tax_year) for health score / funder report panels.
  form990ReadinessFiling Json?
  /// Operator-entered 13-week cash flow assumptions (snake_case API shape) for deterministic forecast dashboard.
  cashFlowForecastInputs Json?
  stripeAccountId  String?
  stripeCustomerId String?         @unique
  stripeSubscriptionId String?     @unique
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  complianceCalendar ComplianceCalendar[]
  governanceProfile  GovernanceProfile?
  boardGovernanceMembers BoardGovernanceMember[]
  stateRegistrations OrgStateRegistration[]
  auditPrepItems     OrgAuditPrepItem[]
  grants             Grant[]
  grantProposals     GrantProposal[]
  restrictedFunds    RestrictedFund[]
  restrictedFundUsageEvents RestrictedFundUsageEvent[]
  workerRelationships WorkerOrgRelationship[]
  incomeTransactions  IncomeTransaction[]
  sessions           Session[]

  // Claude Partner layer
  claudeConfig       OrgClaudeConfig?
  promptLibraries    OrgPromptLibrary[]
  claudeUsageLogs    ClaudeUsageLog[]

  institutionalPartnersBilling InstitutionalPartner[] @relation("InstitutionalPartnerBilling")
  partnerOrgMemberships        PartnerOrgMembership[]
}

model GovernanceProfile {
  id                       String   @id @default(uuid()) @db.Uuid
  orgId                    String   @unique @db.Uuid
  conflictOfInterestPolicy Boolean  @default(false)
  whistleblowerPolicy      Boolean  @default(false)
  documentRetentionPolicy  Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
}

model BoardGovernanceMember {
  id                         String                @id @default(uuid()) @db.Uuid
  orgId                      String                @db.Uuid
  name                       String
  officerRole                GovernanceOfficerRole?
  termStart                  DateTime?
  termEnd                    DateTime?
  conflictDisclosureSignedAt DateTime?
  meetingsHeld               Int?
  meetingsAttended           Int?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, termEnd])
  @@index([orgId, name])
}

model OrgStateRegistration {
  id               String                  @id @default(uuid()) @db.Uuid
  orgId            String                  @db.Uuid
  stateCode        String                  @db.Char(2)
  status           StateRegistrationStatus
  solicitsDonations Boolean                @default(true)
  renewalDueDate   DateTime?
  renewalNotes     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, stateCode])
  @@index([orgId, renewalDueDate])
}

model Session {
  id               String   @id @default(cuid())
  userId           String   @db.Uuid
  orgId            String   @db.Uuid
  refreshTokenHash String   @unique
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  ip               String?
  userAgent        String?

  user User         @relation(fields: [userId], references: [id])
  org  Organization @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@index([expiresAt])
}

model StripeWebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @unique  // Stripe event.id for idempotency
  eventType   String
  processedAt DateTime @default(now())
  succeeded   Boolean  @default(true)
  error       String?

  @@index([eventId])
  @@index([processedAt])
}

model ComplianceCalendar {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @db.Uuid
  deadlineType ComplianceDeadlineType
  dueDate      DateTime
  status       ComplianceStatus
  asanaTaskId  String?
  createdAt    DateTime              @default(now())

  organization Organization          @relation(fields: [orgId], references: [id])

  @@index([orgId, dueDate])
}

model Grant {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @db.Uuid
  funderName        String
  totalAmount       Decimal  @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  spentToDate       Decimal  @db.Decimal(12, 2)
  reportingSchedule Json
  createdAt         DateTime @default(now())

  organization      Organization          @relation(fields: [orgId], references: [id])
  workerRelationships WorkerOrgRelationship[]

  @@index([orgId, endDate])
}

model GrantProposal {
  id              String              @id @default(uuid()) @db.Uuid
  orgId           String              @db.Uuid
  funderName      String
  programName     String
  requestedAmount Decimal             @db.Decimal(12, 2)
  status          GrantProposalStatus @default(DRAFT)
  sections        Json
  qualityScore    Int?
  generatedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

enum GrantProposalStatus {
  DRAFT
  GENERATING
  COMPLETE
  FAILED
}

enum GovernanceOfficerRole {
  CHAIR
  VICE_CHAIR
  TREASURER
  SECRETARY
  PRESIDENT
  MEMBER_AT_LARGE
  OTHER
}

enum StateRegistrationStatus {
  ACTIVE
  PENDING
  NOT_REGISTERED
  UNKNOWN
}

enum AuditPrepCategory {
  GOVERNANCE_BOARD_MINUTES
  BANK_CASH_RECONCILIATIONS
  PAYROLL_COMPENSATION
  GRANT_RESTRICTED_FUNDS
  CONTRACTS_LEASES_AGREEMENTS
  PRIOR_YEAR_FINDING_REMEDIATION
}

enum AuditPrepItemStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  BLOCKED
}

enum PartnerUserRole {
  PARTNER_ADMIN
  PARTNER_VIEWER
}

model OrgAuditPrepItem {
  id                 String              @id @default(uuid()) @db.Uuid
  orgId              String              @db.Uuid
  templateItemKey    String
  category           AuditPrepCategory
  title              String
  status             AuditPrepItemStatus @default(NOT_STARTED)
  targetDate         DateTime?
  assignee           String?
  notes              String?
  evidenceReference  String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, templateItemKey])
  @@index([orgId])
  @@index([orgId, category])
  @@index([orgId, status])
}

model InstitutionalPartner {
  id             String   @id @default(uuid()) @db.Uuid
  billingOrgId   String   @db.Uuid
  displayName    String
  slug           String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  billingOrganization Organization         @relation("InstitutionalPartnerBilling", fields: [billingOrgId], references: [id])
  memberships         PartnerOrgMembership[]
  partnerUsers        PartnerUser[]
  programs            PartnerProgram[]

  @@index([billingOrgId])
}

model PartnerProgram {
  id              String   @id @default(uuid()) @db.Uuid
  partnerId       String   @db.Uuid
  label           String
  slug            String?
  isActive        Boolean  @default(true)
  notes           String?
  enabledFeatures String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partner     InstitutionalPartner     @relation(fields: [partnerId], references: [id])
  memberships PartnerOrgMembership[]

  @@unique([partnerId, slug])
  @@index([partnerId])
}

model PartnerUser {
  id        String          @id @default(uuid()) @db.Uuid
  partnerId String          @db.Uuid
  userId    String          @db.Uuid
  role      PartnerUserRole
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  partner InstitutionalPartner @relation(fields: [partnerId], references: [id])
  user    User                 @relation(fields: [userId], references: [id])

  @@unique([partnerId, userId])
  @@index([userId])
}

model PartnerOrgMembership {
  id            String   @id @default(uuid()) @db.Uuid
  partnerId     String   @db.Uuid
  orgId         String   @db.Uuid
  programId     String?  @db.Uuid
  cohortLabel   String?
  isActive      Boolean  @default(true)
  partnerNotes  String?
  partnerTags   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner InstitutionalPartner @relation(fields: [partnerId], references: [id])
  org     Organization         @relation(fields: [orgId], references: [id])
  program PartnerProgram?      @relation(fields: [programId], references: [id])

  @@unique([partnerId, orgId])
  @@index([partnerId])
  @@index([orgId])
  @@index([programId])
}

model Worker {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  name            String?
  passwordHash    String?  // bcrypt hash — nullable for migration period
  workerTier      WorkerTier @default(FREE)
  ssnEncrypted    String?  // encrypted
  plaidAccessToken String? // encrypted
  stripeCustomerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workerOrgRelationships WorkerOrgRelationship[]
  incomeTransactions     IncomeTransaction[]
  taxEstimates           TaxEstimate[]
  claudeUsageLogs        ClaudeUsageLog[]
}

model WorkerOrgRelationship {
  id                String                @id @default(uuid()) @db.Uuid
  workerId          String                @db.Uuid
  orgId             String                @db.Uuid
  relationshipType  WorkerRelationshipType
  startDate         DateTime
  endDate           DateTime?
  annualCompensation Decimal?            @db.Decimal(12, 2)
  hoursPerWeek      Int?
  grantFunded       Boolean
  grantId           String?              @db.Uuid
  createdAt         DateTime             @default(now())

  worker            Worker                @relation(fields: [workerId], references: [id])
  organization      Organization          @relation(fields: [orgId], references: [id])
  grant             Grant?                @relation(fields: [grantId], references: [id])

  @@unique([workerId, orgId])
  @@index([workerId], map: "idx_worker_org_workerId")
  @@index([orgId], map: "idx_worker_org_orgId")
  @@index([grantId], map: "idx_worker_org_grantId")
}

model IncomeTransaction {
  id               String     @id @default(uuid()) @db.Uuid
  workerId         String     @db.Uuid
  sourceOrgId      String?    @db.Uuid
  amount           Decimal    @db.Decimal(12, 2)
  transactionDate  DateTime
  incomeType       IncomeType
  taxForm          TaxFormType
  plaidTransactionId String?
  stripePaymentId  String?
  createdAt        DateTime   @default(now())

  worker           Worker       @relation(fields: [workerId], references: [id])
  organization     Organization? @relation(fields: [sourceOrgId], references: [id])

  @@index([workerId, transactionDate])
  @@index([sourceOrgId], map: "idx_income_sourceOrgId")
}

model TaxEstimate {
  id              String   @id @default(uuid()) @db.Uuid
  workerId        String   @db.Uuid
  taxYear         Int
  quarter         Int
  estimatedFederal Decimal @db.Decimal(12, 2)
  estimatedState  Decimal  @db.Decimal(12, 2)
  paidFederal     Decimal? @db.Decimal(12, 2)
  paidState       Decimal? @db.Decimal(12, 2)
  dueDate         DateTime
  createdAt       DateTime @default(now())

  worker          Worker   @relation(fields: [workerId], references: [id])

  @@index([workerId, taxYear, quarter])
}

model AgentRun {
  id         String        @id @default(uuid()) @db.Uuid
  agentName  String
  scopeType  AgentScopeType
  scopeId    String        @db.Uuid
  windowStart DateTime
  windowEnd   DateTime
  status     AgentRunStatus
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  error      String?
  metrics    Json?

  @@index([agentName, scopeType, scopeId])
  @@index([windowEnd])
  @@unique([agentName, scopeType, scopeId, windowStart, windowEnd])
}

model Alert {
  id                String        @id @default(uuid()) @db.Uuid
  scopeType          AgentScopeType
  scopeId            String        @db.Uuid
  severity           AlertSeverity
  type               String
  title              String
  body               String
  recommendedActions Json
  dedupeKey          String        @unique
  createdAt          DateTime      @default(now())
  acknowledgedAt     DateTime?

  @@index([scopeType, scopeId])
  @@index([createdAt])
}

// ─── Claude Partner Models ───────────────────────────────────────────────────

model OrgClaudeConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @unique @db.Uuid
  enabled             Boolean  @default(false)
  defaultModel        String
  maxTokens           Int
  temperature         Float
  monthlyTokenCap     Int      @default(200000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [orgId], references: [id])
}

model OrgPromptLibrary {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  name       String
  promptType PromptType
  systemPrompt String
  userTemplate String
  version    Int
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, promptType, version])
  @@index([orgId, promptType, isActive])
  @@index([orgId, createdAt])
}

model ClaudeUsageLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  workerId   String?  @db.Uuid
  promptType String
  tokenCount Int
  cost       Decimal  @db.Decimal(12, 6)
  timestamp  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  worker       Worker?      @relation(fields: [workerId], references: [id])

  @@index([orgId, timestamp])
  @@index([orgId, promptType, timestamp])
}

// ─── Restricted Fund Tracking (v1) ────────────────────────────────────────────
//
// IMPORTANT: This is NOT full GAAP fund accounting. These records are a narrow,
// auditable tracking ledger for restricted funds (grants and donor-restricted).

model RestrictedFund {
  id                     String   @id @default(uuid()) @db.Uuid
  orgId                  String   @db.Uuid
  name                   String
  sourceName             String
  totalRestrictedAmount  Decimal  @db.Decimal(12, 2)
  restrictionPurpose     String
  startDate              DateTime
  endDate                DateTime
  allowableSpendCategories Json    // array of { code, label }
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  usageEvents  RestrictedFundUsageEvent[]

  @@index([orgId, endDate])
  @@index([orgId, createdAt])
}

model RestrictedFundUsageEvent {
  id               String   @id @default(uuid()) @db.Uuid
  restrictedFundId String   @db.Uuid
  orgId            String   @db.Uuid
  occurredAt       DateTime
  amount           Decimal  @db.Decimal(12, 2)
  categoryCode     String?
  memo             String?
  createdAt        DateTime @default(now())

  restrictedFund RestrictedFund @relation(fields: [restrictedFundId], references: [id])
  organization   Organization   @relation(fields: [orgId], references: [id])

  @@index([orgId, occurredAt])
  @@index([restrictedFundId, occurredAt])
}
