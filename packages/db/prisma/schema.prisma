generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  STARTER
  GROWTH
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ComplianceDeadlineType {
  FORM_990
  STATE_REGISTRATION
  GRANT_REPORT
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  FILED
}

enum WorkerRelationshipType {
  W2_EMPLOYEE
  CONTRACTOR_1099
  BOARD_MEMBER
}

enum WorkerTier {
  FREE
  PREMIUM
}

enum IncomeType {
  SALARY
  CONSULTING
  SPEAKING
  ROYALTY
}

enum TaxFormType {
  W2
  NEC_1099
  MISC_1099
}

enum AgentScopeType {
  ORG
  WORKER
  GRANT
}

enum AgentRunStatus {
  STARTED
  SUCCESS
  FAILED
}

enum AlertSeverity {
  LOW
  MED
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum AlertOwnerType {
  USER
  AGENT
  SYSTEM
}

enum PromptType {
  GRANT_DRAFT
  BOARD_REPORT
  DONOR_UPDATE
  INTERNAL_MEMO
}

enum ClaudeStatus {
  NOT_ENABLED
  CONFIGURING
  ACTIVE
  SUSPENDED
}

enum StripeConnectOnboardingStatus {
  NOT_STARTED
  LINK_CREATED
  IN_PROGRESS
  ENABLED
  RESTRICTED
}

/// Platform autonomy classification for AgentRun audit (org settings cannot exceed these bounds).
enum AutonomyTier {
  TIER_A_AUTONOMOUS
  TIER_B_ASK_FIRST
  TIER_C_NEVER
}

enum AgentHandoffStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CANCELLED
}

/// Five org identity / heartbeat documents (markdown in `content`).
enum OrgContextFileKind {
  ORG_IDENTITY
  ORG_SOUL
  ORG_AGENTS
  ORG_MEMORY
  ORG_HEARTBEAT
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model Organization {
  id              String           @id @default(uuid()) @db.Uuid
  ein             String           @unique
  name            String
  annualRevenue   Decimal?         @db.Decimal(12, 2)
  fiscalYearEnd   DateTime?
  subscriptionTier SubscriptionTier
  claudeStatus    ClaudeStatus     @default(NOT_ENABLED)
  plaidAccessToken String?         // encrypted
  stripeAccountId  String?
  stripeCustomerId String?         @unique
  stripeSubscriptionId String?     @unique
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  complianceCalendar ComplianceCalendar[]
  grants             Grant[]
  workerRelationships WorkerOrgRelationship[]
  incomeTransactions  IncomeTransaction[]

  // Claude Partner layer
  claudeConfig       OrgClaudeConfig?
  promptLibraries    OrgPromptLibrary[]
  claudeUsageLogs    ClaudeUsageLog[]
  sessions           Session[]

  agentHandoffs                 AgentHandoff[]
  orgContextFiles               OrgContextFile[]
  agentOperationalMemoryEntries AgentOperationalMemoryEntry[]
  orgCuratedMemoryItems         OrgCuratedMemoryItem[]
  orgSemanticMemoryChunks       OrgSemanticMemoryChunk[]

  autonomousOpsSettings         OrgAutonomousOpsSettings?
  donorEvents                   DonorEvent[]
  volunteerEvents               VolunteerEvent[]

  // S4NP Phase 1 donor CRM and receipts
  donors                        Donor[]
  donations                     Donation[]
  donationReceipts              DonationReceipt[]
  donationImportBatches         DonationImportBatch[]
  donationImportRows            DonationImportRow[]
  donorNotes                    DonorNote[]
  stripeConnectAccount          StripeConnectAccount?
}

model StripeConnectAccount {
  id                           String                        @id @default(uuid()) @db.Uuid
  orgId                        String                        @unique @db.Uuid
  stripeAccountId              String                        @unique
  onboardingStatus             StripeConnectOnboardingStatus @default(NOT_STARTED)
  detailsSubmitted             Boolean                       @default(false)
  chargesEnabled               Boolean                       @default(false)
  payoutsEnabled               Boolean                       @default(false)
  requirementsCurrentlyDue     Json?
  requirementsEventuallyDue    Json?
  disabledReason               String?
  country                      String?                       @db.VarChar(2)
  defaultCurrency              String?                       @db.VarChar(8)
  onboardingLinkLastCreatedAt  DateTime?
  onboardingLinkExpiresAt      DateTime?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([onboardingStatus])
}

/// Append-only donor gift ledger row (ingested from Stripe, CSV, manual API, etc.).
/// Executive donor_ops and APIs use only these rows — not unrelated income tables.
model DonorEvent {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @db.Uuid
  occurredAt   DateTime
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @default("USD") @db.VarChar(8)
  sourceSystem String   @db.VarChar(64)
  sourceRef    String   @db.VarChar(512)
  raw          Json?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sourceSystem, sourceRef])
  @@index([orgId, occurredAt])
}

/// Append-only volunteer time ledger row (manual API, CSV import, etc.). Hours are recorded as reported by the source; not inferred from payroll or other systems.
model VolunteerEvent {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  occurredAt     DateTime
  hours          Decimal  @db.Decimal(10, 2)
  activityLabel  String?  @db.VarChar(256)
  sourceSystem   String   @db.VarChar(64)
  sourceRef      String   @db.VarChar(512)
  raw            Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, sourceSystem, sourceRef])
  @@index([orgId, occurredAt])
}

enum AutonomousOpsBoundaryMode {
  internal_only
  ask_first
  never
}

model OrgAutonomousOpsSettings {
  id                    String      @id @default(uuid()) @db.Uuid
  orgId                 String      @unique @db.Uuid
  enabledAgents         Json
  maxAutonomyTier       AutonomyTier @default(TIER_A_AUTONOMOUS)
  agentBoundaryOverrides Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model ComplianceCalendar {
  id           String                @id @default(uuid()) @db.Uuid
  orgId        String                @db.Uuid
  deadlineType ComplianceDeadlineType
  dueDate      DateTime
  status       ComplianceStatus
  asanaTaskId  String?
  createdAt    DateTime              @default(now())

  organization Organization          @relation(fields: [orgId], references: [id])

  @@index([orgId, dueDate])
}

model Grant {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @db.Uuid
  funderName        String
  totalAmount       Decimal  @db.Decimal(12, 2)
  startDate         DateTime
  endDate           DateTime
  spentToDate       Decimal  @db.Decimal(12, 2)
  reportingSchedule Json
  createdAt         DateTime @default(now())

  organization      Organization          @relation(fields: [orgId], references: [id])
  workerRelationships WorkerOrgRelationship[]

  @@index([orgId, endDate])
}

model Worker {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  name            String?
  passwordHash    String?  // bcrypt hash — nullable for migration period
  workerTier      WorkerTier @default(FREE)
  ssnEncrypted    String?  // encrypted
  plaidAccessToken String? // encrypted
  stripeCustomerId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workerOrgRelationships WorkerOrgRelationship[]
  incomeTransactions     IncomeTransaction[]
  taxEstimates           TaxEstimate[]
  claudeUsageLogs        ClaudeUsageLog[]
  sessions               Session[]
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  workerId          String    @db.Uuid
  orgId             String    @db.Uuid
  refreshTokenHash  String    // SHA-256 hash of refresh token
  expiresAt         DateTime
  revokedAt         DateTime?
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())

  worker            Worker       @relation(fields: [workerId], references: [id])
  organization      Organization @relation(fields: [orgId], references: [id])

  @@unique([refreshTokenHash])
  @@index([workerId, revokedAt])
  @@index([expiresAt])
  @@index([orgId])
}

model WorkerOrgRelationship {
  id                String                @id @default(uuid()) @db.Uuid
  workerId          String                @db.Uuid
  orgId             String                @db.Uuid
  relationshipType  WorkerRelationshipType
  startDate         DateTime
  endDate           DateTime?
  annualCompensation Decimal?            @db.Decimal(12, 2)
  hoursPerWeek      Int?
  grantFunded       Boolean
  grantId           String?              @db.Uuid
  createdAt         DateTime             @default(now())

  worker            Worker                @relation(fields: [workerId], references: [id])
  organization      Organization          @relation(fields: [orgId], references: [id])
  grant             Grant?                @relation(fields: [grantId], references: [id])

  @@unique([workerId, orgId])
}

model IncomeTransaction {
  id               String     @id @default(uuid()) @db.Uuid
  workerId         String     @db.Uuid
  sourceOrgId      String?    @db.Uuid
  amount           Decimal    @db.Decimal(12, 2)
  transactionDate  DateTime
  incomeType       IncomeType
  taxForm          TaxFormType
  plaidTransactionId String?
  stripePaymentId  String?
  createdAt        DateTime   @default(now())

  worker           Worker       @relation(fields: [workerId], references: [id])
  organization     Organization? @relation(fields: [sourceOrgId], references: [id])

  @@index([workerId, transactionDate])
}

model TaxEstimate {
  id              String   @id @default(uuid()) @db.Uuid
  workerId        String   @db.Uuid
  taxYear         Int
  quarter         Int
  estimatedFederal Decimal @db.Decimal(12, 2)
  estimatedState  Decimal  @db.Decimal(12, 2)
  paidFederal     Decimal? @db.Decimal(12, 2)
  paidState       Decimal? @db.Decimal(12, 2)
  dueDate         DateTime
  createdAt       DateTime @default(now())

  worker          Worker   @relation(fields: [workerId], references: [id])

  @@index([workerId, taxYear, quarter])
}

model AgentRun {
  id         String        @id @default(uuid()) @db.Uuid
  agentName  String
  scopeType  AgentScopeType
  scopeId    String        @db.Uuid
  windowStart DateTime
  windowEnd   DateTime
  status     AgentRunStatus
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  error      String?
  metrics    Json?

  autonomyTier        AutonomyTier @default(TIER_A_AUTONOMOUS)
  requiresHumanReview Boolean      @default(false)
  sourceRefs          Json?
  humanReviewedAt     DateTime?
  humanReviewedBy     String?

  handoffs                   AgentHandoff[]
  agentOperationalMemories   AgentOperationalMemoryEntry[]
  relatedAlerts              Alert[] @relation("AlertRelatedAgentRun")

  @@index([agentName, scopeType, scopeId])
  @@index([windowEnd])
  @@unique([agentName, scopeType, scopeId, windowStart, windowEnd])
}

model AgentHandoff {
  id                  String             @id @default(uuid()) @db.Uuid
  orgId               String             @db.Uuid
  fromAgentName       String
  toAgentName         String
  title               String
  body                String             @db.Text
  urgency             String             @default("normal")
  requiresHumanReview Boolean            @default(false)
  status              AgentHandoffStatus @default(OPEN)
  sourceEvidence      Json?
  relatedAgentRunId   String?            @db.Uuid
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  resolvedAt          DateTime?

  organization    Organization @relation(fields: [orgId], references: [id])
  relatedAgentRun AgentRun?    @relation(fields: [relatedAgentRunId], references: [id])
  auditEntries    AgentHandoffAuditEntry[]
  relatedAlerts   Alert[] @relation("AlertRelatedHandoff")

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

/// Append-only audit trail for AgentHandoff lifecycle (internal agents / staff actions).
model AgentHandoffAuditEntry {
  id         String              @id @default(uuid()) @db.Uuid
  handoffId  String              @db.Uuid
  createdAt  DateTime            @default(now())
  action     String
  fromStatus AgentHandoffStatus?
  toStatus   AgentHandoffStatus?
  actorType  String
  actorName  String?
  detail     Json?

  handoff AgentHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@index([handoffId, createdAt])
}

model OrgContextFile {
  id        String             @id @default(uuid()) @db.Uuid
  orgId     String             @db.Uuid
  kind      OrgContextFileKind
  content   String             @db.Text
  updatedAt DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, kind])
}

/// Tier 1 operational memory: append-only log of agent outputs (convention; not enforced in DB).
model AgentOperationalMemoryEntry {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  agentName  String
  kind       String
  payload    Json
  sourceRefs Json?
  agentRunId String?  @db.Uuid
  createdAt  DateTime @default(now())
  /// 0–1 when set; null means unspecified confidence.
  confidence           Float?
  /// When true, excluded from default recall paths (redaction / do-not-use).
  recallDisabled       Boolean  @default(false)
  recallDisabledReason String?  @db.Text

  organization Organization @relation(fields: [orgId], references: [id])
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id])

  @@index([orgId, createdAt])
  @@index([orgId, agentName])
  @@index([orgId, recallDisabled])
}

/// Tier 2 curated memory: human- or policy-approved durable facts (still not authoritative oracle truth).
model OrgCuratedMemoryItem {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @db.Uuid
  title       String?
  body        String   @db.Text
  /// Explicit uncertainty / reliability hint for consumers (0–1).
  confidence  Float    @default(0.5)
  sourceRefs  Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, isActive])
  @@index([orgId, updatedAt])
}

/// Tier 3 semantic memory: text chunks for retrieval; keyword search until embeddings are enabled.
model OrgSemanticMemoryChunk {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @db.Uuid
  chunkText      String   @db.Text
  confidence     Float    @default(0.4)
  sourceRefs     Json?
  /// Reserved for future vector index; search remains keyword-only while false.
  embeddingReady Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
}

model Alert {
  id                String        @id @default(uuid()) @db.Uuid
  /// Stable agent name that emitted the alert (source attribution; do not infer from UI state).
  agentName         String
  scopeType          AgentScopeType
  scopeId            String        @db.Uuid
  severity           AlertSeverity
  status             AlertStatus   @default(OPEN)
  type               String
  title              String
  body               String
  recommendedActions Json
  dedupeKey          String        @unique
  createdAt          DateTime      @default(now())
  acknowledgedAt     DateTime?
  resolvedAt         DateTime?
  resolutionSummary  String?       @db.Text
  ownerType          AlertOwnerType?
  ownerId            String?
  ownerName          String?
  relatedAgentRunId  String?       @db.Uuid
  relatedHandoffId   String?       @db.Uuid

  relatedAgentRun AgentRun?     @relation("AlertRelatedAgentRun", fields: [relatedAgentRunId], references: [id], onDelete: SetNull)
  relatedHandoff  AgentHandoff? @relation("AlertRelatedHandoff", fields: [relatedHandoffId], references: [id], onDelete: SetNull)
  auditEntries    AlertAuditEntry[]

  @@index([agentName])
  @@index([scopeType, scopeId])
  @@index([createdAt])
}

/// Append-only audit trail for Alert lifecycle (internal agents / staff actions).
model AlertAuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  alertId   String   @db.Uuid
  createdAt DateTime @default(now())
  action    String
  fromStatus AlertStatus?
  toStatus   AlertStatus?
  actorType  String
  actorName  String?
  detail     Json?

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
}

// ─── Claude Partner Models ───────────────────────────────────────────────────

model OrgClaudeConfig {
  id                  String   @id @default(uuid()) @db.Uuid
  orgId               String   @unique @db.Uuid
  enabled             Boolean  @default(false)
  defaultModel        String
  maxTokens           Int
  temperature         Float
  monthlyTokenCap     Int      @default(200000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization        Organization @relation(fields: [orgId], references: [id])
}

model OrgPromptLibrary {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  name       String
  promptType PromptType
  systemPrompt String
  userTemplate String
  version    Int
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, promptType, version])
  @@index([orgId, promptType, isActive])
  @@index([orgId, createdAt])
}

model ClaudeUsageLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @db.Uuid
  workerId   String?  @db.Uuid
  promptType String
  tokenCount Int
  cost       Decimal  @db.Decimal(12, 6)
  timestamp  DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  worker       Worker?      @relation(fields: [workerId], references: [id])

  @@index([orgId, timestamp])
  @@index([orgId, promptType, timestamp])
}

// ─── S4NP Phase 1 Donor CRM + Receipts ──────────────────────────────────────

enum DonorType {
  INDIVIDUAL
  ORGANIZATION
}

enum DonationSource {
  MANUAL
  CSV_IMPORT
  OTHER
}

enum ReceiptStatus {
  DRAFT
  ISSUED
  VOIDED
}

model Donor {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @db.Uuid
  donorType   DonorType @default(INDIVIDUAL)
  name        String    @db.VarChar(256)
  email       String?   @db.VarChar(256)
  phone       String?   @db.VarChar(64)
  addressJson String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  donations    Donation[]
  donorNotes   DonorNote[]
  importRows   DonationImportRow[]

  @@unique([orgId, email])
  @@index([orgId])
}

model DonorNote {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  donorId   String   @db.Uuid
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  donor        Donor        @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([donorId])
}

model Donation {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @db.Uuid
  donorId         String         @db.Uuid
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("USD") @db.VarChar(8)
  receivedAt      DateTime
  paymentMethod   String         @db.VarChar(64)
  referenceNumber String?        @db.VarChar(128)
  notes           String?        @db.Text
  source          DonationSource @default(MANUAL)
  importRowId     String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  donor        Donor              @relation(fields: [donorId], references: [id], onDelete: Cascade)
  importRow    DonationImportRow? @relation(fields: [importRowId], references: [id], onDelete: SetNull)
  receipt      DonationReceipt?

  @@index([orgId, receivedAt])
  @@index([donorId])
}

model DonationReceipt {
  id            String        @id @default(uuid()) @db.Uuid
  orgId         String        @db.Uuid
  donationId    String        @unique @db.Uuid
  receiptNumber String        @db.VarChar(64)
  status        ReceiptStatus @default(DRAFT)
  issuedAt      DateTime?
  voidedAt      DateTime?
  voidReason    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  donation     Donation     @relation(fields: [donationId], references: [id], onDelete: Restrict)

  @@unique([orgId, receiptNumber])
  @@index([orgId])
}

model DonationImportBatch {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  fileName  String   @db.VarChar(256)
  rowCount  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rows         DonationImportRow[]

  @@index([orgId])
}

model DonationImportRow {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @db.Uuid
  batchId       String   @db.Uuid
  rawLineNumber Int
  rawContent    String   @db.Text
  donorId       String?  @db.Uuid
  status        String   @db.VarChar(32)
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch        DonationImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  donor        Donor?              @relation(fields: [donorId], references: [id], onDelete: SetNull)
  donations    Donation[]

  @@index([orgId])
  @@index([batchId])
}
