{
  "name": "@magnus/db",
  "version": "1.0.0",
  "private": true,
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./schemaGuards": {
      "types": "./dist/schemaGuards.d.ts",
      "default": "./dist/schemaGuards.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prisma": "node scripts/prisma.cjs",
    "prisma:generate": "pnpm prisma generate",
    "prisma:migrate": "pnpm prisma migrate dev",
    "prisma:deploy": "pnpm prisma migrate deploy",
    "prisma:studio": "pnpm prisma studio",
    "verify:schema": "pnpm build && node dist/verifyDbShape.js --profile=autonomous_ops",
    "test": "pnpm build && node --test dist/tests"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "dotenv": "^16.4.5",
    "prisma": "^5.22.0",
    "typescript": "^5.5.4"
  }
}