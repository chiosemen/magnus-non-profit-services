# Magnus Accord .dockerignore

# Dependency / Build caches
node_modules
**/*/node_modules
.turbo
.next
dist
build
out
.eslintcache
.npm
.pnpm-store

# Logs & Debug data
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test suites & Configuration limits
**/__tests__/**
**/*.test.ts
**/*.test.js
**/*.spec.ts
jest.config.js
vitest.config.ts
coverage
.nyc_output

# Environment Secrets
.env*
!.env.template
*.pem
*.key
*.cert
*.crt
credentials.json

# IDE, OS & Tools
.vscode
.idea
.DS_Store
Thumbs.db
.git
.gitignore
.github
*.md
LICENSE
docs/

