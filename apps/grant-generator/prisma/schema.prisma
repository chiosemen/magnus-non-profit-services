// Magnus Nonprofit OS — Prisma Schema
// Covers both MCP Connector and Grant Proposal Generator

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organizations ─────────────────────────────────────────────────────────────

model Organization {
  id                  String   @id @default(uuid())
  ein                 String   @unique
  name                String
  city                String?
  state               String?
  nteeCode            String?
  missionStatement    String?  @db.Text
  foundingYear        Int?
  annualBudget        Decimal? @db.Decimal(15, 2)
  programRatio        Decimal? @db.Decimal(5, 2)
  employeeCount       Int?
  volunteerCount      Int?
  websiteUrl          String?
  filingStatus        String   @default("unknown")
  lastSyncedAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               UserOrganization[]
  grantApplications   GrantApplication[]
  complianceRecords   ComplianceRecord[]

  @@index([ein])
  @@index([state, nteeCode])
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  passwordHash  String
  roles         String[] @default(["viewer"])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  organizations UserOrganization[]
  sessions      UserSession[]
  auditLogs     AuditLog[]

  @@index([email])
}

model UserOrganization {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           String   @default("member")
  permissions    String[] @default([])
  createdAt      DateTime @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model UserSession {
  id            String   @id @default(uuid())
  userId        String
  clientId      String
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  isActive      Boolean  @default(true)
  lastActivityAt DateTime @default(now())
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([expiresAt])
}

// ─── Compliance ───────────────────────────────────────────────────────────────

model ComplianceRecord {
  id               String   @id @default(uuid())
  organizationId   String
  ein              String
  filingType       String   // 990, 990-EZ, 990-N, 990-PF
  taxYear          Int
  filingDate       DateTime?
  taxPeriodEnd     String?
  totalRevenue     BigInt?
  totalExpenses    BigInt?
  netAssets        BigInt?
  programExpenses  BigInt?
  adminExpenses    BigInt?
  fundraisingExpenses BigInt?
  employeeCount    Int?
  pdfUrl           String?
  isAmended        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])

  @@unique([ein, taxYear])
  @@index([ein])
  @@index([taxYear])
}

// ─── Grant Applications ───────────────────────────────────────────────────────

model GrantApplication {
  id                String   @id @default(uuid())
  organizationId    String
  funderEIN         String?
  funderName        String
  programName       String
  projectName       String
  requestedAmount   Decimal  @db.Decimal(12, 2)
  totalProjectCost  Decimal? @db.Decimal(12, 2)
  projectStartDate  DateTime?
  projectEndDate    DateTime?
  status            String   @default("draft")  // draft, generating, review, submitted, awarded, declined
  targetPopulation  String?
  geographicArea    String?
  numberToBeServed  Int?
  submittedAt       DateTime?
  awardedAt         DateTime?
  awardedAmount     Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization           @relation(fields: [organizationId], references: [id])
  sections          GrantProposalSection[]
  intakeResponses   GrantIntakeResponse[]

  @@index([organizationId])
  @@index([status])
  @@index([funderName])
}

model GrantProposalSection {
  id                  String   @id @default(uuid())
  applicationId       String
  sectionType         String   // executive_summary, need_statement, etc.
  title               String
  content             String   @db.Text
  wordCount           Int      @default(0)
  wordLimit           Int?
  status              String   @default("draft")  // draft, generated, approved, revision_requested
  generationAttempts  Int      @default(0)
  qualityScore        Int?
  completenessScore   Int?
  aiModel             String?
  promptTokens        Int?
  completionTokens    Int?
  generatedAt         DateTime?
  approvedAt          DateTime?
  revisionNotes       String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  application         GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, sectionType])
  @@index([applicationId])
  @@index([status])
}

model GrantIntakeResponse {
  id                String   @id @default(uuid())
  applicationId     String
  fieldName         String
  fieldValue        String   @db.Text
  fieldType         String   @default("text")  // text, number, date, multiline
  isRequired        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  application       GrantApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, fieldName])
  @@index([applicationId])
}

// ─── Grant Opportunities & Funders ────────────────────────────────────────────

model GrantOpportunity {
  id                    String   @id @default(uuid())
  funderName            String
  funderEIN             String?
  programName           String
  description           String?  @db.Text
  focusAreas            String[] @default([])
  eligibleNTEECodes     String[] @default([])
  eligibleStates        String[] @default([])
  minGrantAmount        Decimal? @db.Decimal(12, 2)
  maxGrantAmount        Decimal? @db.Decimal(12, 2)
  totalGiving           Decimal? @db.Decimal(15, 2)
  applicationDeadline   DateTime?
  loiDeadline           DateTime?
  isRollingDeadline     Boolean  @default(false)
  applicationUrl        String?
  contactEmail          String?
  requiresLOI           Boolean  @default(false)
  acceptsUnsolicited    Boolean  @default(true)
  averageGrantSize      Decimal? @db.Decimal(12, 2)
  grantCount            Int?
  dataSource            String   @default("candid")
  lastUpdated           DateTime @default(now())
  createdAt             DateTime @default(now())

  @@index([funderEIN])
  @@index([applicationDeadline])
}

model FunderProfile {
  id                   String   @id @default(uuid())
  ein                  String   @unique
  name                 String
  type                 String   // private_foundation, community_foundation, etc.
  location             String?
  annualGiving         Decimal? @db.Decimal(15, 2)
  averageGrant         Decimal? @db.Decimal(12, 2)
  totalAssets          Decimal? @db.Decimal(15, 2)
  focusAreas           String[] @default([])
  geographicFocus      String[] @default([])
  nteeFocus            String[] @default([])
  acceptsUnsolicited   Boolean  @default(false)
  hasLOIRequirement    Boolean  @default(false)
  applicationCycle     String?
  websiteUrl           String?
  staffContact         String?
  lastResearched       DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([ein])
}

// ─── Audit Log (Immutable) ────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  orgId         String?
  toolName      String
  action        String   @default("tool_call")
  params        Json?
  result        String?  @db.Text
  success       Boolean
  statusCode    Int?
  durationMs    Int?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  timestamp     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orgId])
  @@index([toolName])
  @@index([timestamp])
  @@index([requestId])

  // No updates or deletes — append-only
}

// ─── Generated Documents ──────────────────────────────────────────────────────

model GeneratedDocument {
  id              String   @id @default(uuid())
  applicationId   String
  format          String   // docx, pdf
  fileName        String
  filePath        String
  fileSize        Int
  pageCount       Int?
  storageProvider String   @default("local")  // local, s3, gcs
  storageUrl      String?
  generatedAt     DateTime @default(now())

  @@index([applicationId])
}

// ─── Prompt Templates (stored config) ─────────────────────────────────────────

model GrantPromptTemplate {
  id              String   @id @default(uuid())
  sectionType     String   @unique
  title           String
  wordLimit       Int
  wordMinimum     Int
  systemPrompt    String   @db.Text
  userPrompt      String   @db.Text
  revisionPrompt  String   @db.Text
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sectionType])
}
