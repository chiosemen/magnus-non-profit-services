# ─── Magnus Grant Proposal Generator — Environment Variables ─────────────────

NODE_ENV=development
PORT=3002

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://magnus:password@localhost:5432/magnus_os

# ─── Anthropic API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-5-20251101
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.7

# ─── Candid MCP Server ────────────────────────────────────────────────────────
CANDID_MCP_URL=https://mcp.candid.org/sse
CANDID_API_KEY=your-candid-api-key

# ─── Plaid MCP Server ─────────────────────────────────────────────────────────
PLAID_MCP_URL=https://mcp.plaid.com/sse
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# ─── Document Storage (S3 / GCS) ──────────────────────────────────────────────
STORAGE_PROVIDER=s3                 # Options: s3 | gcs | local
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=us-east-1
AWS_BUCKET=magnus-grant-documents
GCS_PROJECT_ID=your-gcp-project
GCS_BUCKET=magnus-grant-documents

# ─── Document Output ──────────────────────────────────────────────────────────
OUTPUT_DIR=./generated-documents
MAX_CONCURRENT_GENERATIONS=3

# ─── AI Generation ────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY_MS=1000
SECTION_TIMEOUT_MS=60000
