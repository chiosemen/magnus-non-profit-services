{
  "name": "@magnus/agents",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "run:once": "node dist/index.js run:once",
    "test": "pnpm build && node --test dist/tests"
  },
  "dependencies": {
    "@magnus/config": "workspace:*",
    "@magnus/db": "workspace:*",
    "@magnus/subscription": "workspace:*",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/node": "^22.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "engines": { "node": ">=20.0.0" }
}
