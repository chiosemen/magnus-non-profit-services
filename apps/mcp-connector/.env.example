# ─── Magnus MCP Connector — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in all values before running

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
MCP_TRANSPORT=sse           # Options: sse | stdio

# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
DATABASE_URL=postgresql://magnus:password@localhost:5432/magnus_os
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis (session cache + rate limiting) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=your-256-bit-secret-here-minimum-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=magnus-mcp-connector
JWT_AUDIENCE=magnus-nonprofit-os

# ─── OAuth 2.0 (for MCP client auth) ─────────────────────────────────────────
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
OAUTH_REDIRECT_URI=https://your-domain.com/oauth/callback
OAUTH_AUTHORIZATION_URL=https://auth.magnus-os.com/authorize
OAUTH_TOKEN_URL=https://auth.magnus-os.com/token

# ─── Anthropic API ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-5-20251101
ANTHROPIC_MAX_TOKENS=4096

# ─── ProPublica Nonprofit Explorer API ───────────────────────────────────────
PROPUBLICA_API_KEY=your-propublica-api-key
PROPUBLICA_BASE_URL=https://projects.propublica.org/nonprofits/api/v2

# ─── Candid / GuideStar API (grant opportunities + funder research) ──────────
CANDID_API_KEY=your-candid-api-key
CANDID_BASE_URL=https://api.candid.org/v3

# ─── Plaid API (financial data integration) ──────────────────────────────────
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox              # Options: sandbox | development | production
PLAID_BASE_URL=https://sandbox.plaid.com

# ─── Asana API (task + project management) ───────────────────────────────────
ASANA_ACCESS_TOKEN=your-asana-personal-access-token
ASANA_WORKSPACE_ID=your-asana-workspace-id

# ─── IRS TEOS API (tax-exempt organization status) ───────────────────────────
IRS_TEOS_BASE_URL=https://apps.irs.gov/pub/epostcard/data-download

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000     # 1 minute
RATE_LIMIT_MAX_REQUESTS=100    # per window per client

# ─── Audit Logging ────────────────────────────────────────────────────────────
AUDIT_LOG_LEVEL=info           # Options: debug | info | warn | error
AUDIT_RETENTION_DAYS=365       # Audit logs retained for 1 year
AUDIT_ALERT_THRESHOLD=50       # Anomaly alert after N tool calls per hour

# ─── Session Management ───────────────────────────────────────────────────────
SESSION_TTL_SECONDS=3600       # 1 hour
SESSION_MAX_PER_USER=5

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://claude.ai
CORS_CREDENTIALS=true

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json                # Options: json | pretty
LOG_FILE=./logs/magnus-mcp.log
