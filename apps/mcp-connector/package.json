{
  "name": "@magnus/mcp-connector",
  "version": "1.0.0",
  "description": "Magnus Nonprofit OS — MCP Server for Claude integration",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --transport stdio",
    "start:sse": "node dist/server.js --transport sse",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:stdio": "ts-node src/server.ts --transport stdio",
    "test": "node --test __tests__/smoke.test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:migrate": "pnpm --filter @magnus/db prisma:migrate",
    "db:generate": "pnpm --filter @magnus/db prisma:generate",
    "db:studio": "pnpm --filter @magnus/db prisma:studio",
    "docker:build": "docker build -t magnus-mcp-connector .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "@magnus/config": "workspace:*",
    "@magnus/db": "workspace:*",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "winston": "^3.14.2",
    "uuid": "^10.0.0",
    "date-fns": "^3.6.0",
    "axios": "^1.7.7",
    "ioredis": "^5.4.1",
    "rate-limiter-flexible": "^5.0.3",
    "express-async-handler": "^1.2.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.0",
    "@types/jest": "^29.5.13",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@jest/globals": "^29.7.0",
    "eslint": "^9.9.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nonprofit",
    "compliance",
    "form-990",
    "claude",
    "anthropic"
  ],
  "author": "Magnus Chi <magnus@magnus-compliance.com>",
  "license": "UNLICENSED",
  "private": true
}
