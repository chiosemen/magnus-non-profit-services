# Marketing-only mode (apps/web) — SPEC-P0 R14.
# Set to exactly "true" ONLY on a deployment that serves the public marketing
# hostname. That deployment serves / and /book-audit and returns 404 for every
# application path, and MUST NOT carry DATABASE_URL, DATABASE_URL_UNPOOLED,
# JWT_SECRET, ENCRYPTION_KEY, STRIPE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY,
# ANTHROPIC_API_KEY or SMTP_PASS — the service refuses to start if it does.
# Any value other than "true"/"false" also refuses to start. Leave unset for the
# application deployment. See docs/security/PUBLIC-SURFACE-SEPARATION.md.
# MARKETING_ONLY="true"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/magnus?schema=public"
JWT_SECRET="replace-with-at-least-32-characters"

# Optional: explicitly set NODE_ENV for build/runtime behavior
NODE_ENV="development"

# Public-facing base URL of this app — required in production for CSRF enforcement
# Example: NEXT_PUBLIC_APP_URL="https://app.magnus.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis — required in production for multi-instance-safe web, org-dashboard-api,
# MCP, protected write, payment, AI, and tool route rate limiting.
# Without this, each process has its own in-memory limiter (bypassable by spreading
# requests across instances). Set to a shared Redis URL in all production deployments.
# Example: REDIS_URL="redis://default:password@redis.railway.internal:6379"
# REDIS_URL=


# Optional: same-origin BFF for web -> org-dashboard-api evidence routes
ORG_DASHBOARD_API_BASE_URL="http://localhost:4010"

# Agents runtime (required when running apps/agents)
AGENTS_ENABLED="false"
AGENTS_ALERT_SINK="db"

# Stripe (apps/billing)
STRIPE_SECRET_KEY="REPLACE_WITH_YOUR_STRIPE_KEY"
STRIPE_WEBHOOK_SECRET="REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET"

# Stripe Connect foundation (apps/org-dashboard-api)
STRIPE_CONNECT_RETURN_URL="http://localhost:3000/app/donors/stripe-connect?state=return"
STRIPE_CONNECT_REFRESH_URL="http://localhost:3000/app/donors/stripe-connect?state=refresh"

# Internal MCP Connector health (operator-only; not public beta)
MCP_CONNECTOR_URL="http://localhost:4005"

# Worker financial layer feature gate (Wave 1 — set true only when real calculations are wired)
FEATURE_FLAG_WORKER_FINANCIALS="false"
