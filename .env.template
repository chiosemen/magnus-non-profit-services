DATABASE_URL="postgresql://postgres:postgres@localhost:5432/magnus?schema=public"
JWT_SECRET="replace-with-at-least-32-characters"

# Optional: explicitly set NODE_ENV for build/runtime behavior
NODE_ENV="development"

# Public-facing base URL of this app — required in production for CSRF enforcement
# Example: NEXT_PUBLIC_APP_URL="https://app.magnus.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis — required in production for multi-instance-safe login rate limiting.
# Without this, each process has its own in-memory limiter (bypassable by spreading
# requests across instances). Set to a shared Redis URL in all production deployments.
# Example: REDIS_URL="redis://default:password@redis.railway.internal:6379"
# REDIS_URL=


# Optional: same-origin BFF for web -> org-dashboard-api evidence routes
ORG_DASHBOARD_API_BASE_URL="http://localhost:4010"

# Agents runtime (required when running apps/agents)
AGENTS_ENABLED="false"
AGENTS_ALERT_SINK="db"

# Stripe (apps/billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# MCP Connector health (apps/claude-partner onboarding)
MCP_CONNECTOR_URL="http://localhost:4005"

# Worker financial layer feature gate (Wave 1 — set true only when real calculations are wired)
FEATURE_FLAG_WORKER_FINANCIALS="false"
